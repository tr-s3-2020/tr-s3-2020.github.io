# Ignore the contents of the _site directory
_site/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore bundler's local config (created by `bundle config set --local`)
/.bundle/

# Ingore files created by npm
node_modules
package-lock.json
# Local build/verification helper scripts (not part of the site)
/.scratch/
